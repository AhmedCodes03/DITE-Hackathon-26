# Port used by the API HTTP server.
PORT=5000

# Runtime mode used for logging and security defaults.
NODE_ENV=development

# MongoDB connection string for application data.
MONGO_URI=mongodb://localhost:27017/dr_xyz_appointments

# JWT signing secret for short-lived access tokens.
JWT_SECRET=replace_with_secure_access_secret

# Access token lifetime (e.g. 15m, 1h).
JWT_ACCESS_EXPIRES_IN=15m

# Separate JWT signing secret for refresh tokens.
JWT_REFRESH_SECRET=replace_with_separate_refresh_secret

# Refresh token lifetime (e.g. 7d, 30d).
JWT_REFRESH_EXPIRES_IN=7d

# Allowed frontend origin for CORS.
CLIENT_URL=http://localhost:5173
